# Local budgets, NOT quotas guaranteed by Roblox. Lower on repeated 429s.
ROBLOX_REQUESTS_PER_MINUTE=30
MAX_ACTIVE_PLACES=5
MAX_PANELS_PER_GUILD=10
PANEL_EDIT_SECONDS=5
# legacy: deprecated Roblox instance link, clearly labelled as experimental.
# game: only offer the normal game page (no specific-instance promise).
JOIN_MODE=legacy
LOG_LEVEL=INFO
